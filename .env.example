# Copy to .env and fill in. NEVER commit .env.
# Get a key (free tier available) from Google AI Studio.
GEMINI_API_KEY=
# Live API model. Verify the current ID in Google's docs before use (see docs/PHASE1_VOICE_HUD.md).
GEMINI_LIVE_MODEL=gemini-3.8-live
# Prebuilt voice name (optional)
GEMINI_LIVE_VOICE=Kore
# Server
PORT=8787
# The local server listens on 127.0.0.1 only. HOST=0.0.0.0 opens it to the LAN (put HTTPS in front of it).
# HOST=127.0.0.1
# Behind your own reverse proxy (not Vercel): the header it sets with the client address, for the login rate limits. Leave empty otherwise.
# ELVAR_TRUST_PROXY=x-forwarded-for
# --- Google integration (calendar / Gmail / Drive / Docs / Sheets / Tasks / Contacts) — see docs/GOOGLE_INTEGRATION.md
# Normal use needs NONE of these: Settings > Google takes your own OAuth client id / secret and connects in the app (/google-setup/ explains it).
# Self-hosters only: create a "Desktop app" OAuth client in Google Cloud, then run:  node --env-file-if-exists=.env scripts/google-auth.mjs --write-env
# The public address of the app, for the Google redirect URI (https://...). Needed off Vercel unless you open the app as localhost.
# ELVAR_PUBLIC_ORIGIN=https://elvar.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Time zone (default: the profile's time zone, which the wizard asks for)
# GOOGLE_TIMEZONE=Asia/Tokyo
# --- Owner account, storage and profile -------------------------------------------------------------------------
# Normal use needs NONE of the variables below: open the app, follow the setup wizard, and keys / settings are saved
# (encrypted) in the app. Anything set in the app wins over the same name here; these are the fallback for self-hosters.
#
# Where the app keeps its encrypted settings:
#   - Vercel: add Upstash Redis (Vercel Dashboard > Storage). It sets UPSTASH_REDIS_REST_URL / _TOKEN (or KV_REST_API_*) for you.
#   - Local node server: a file in ~/.elvar/store.json (change the folder with ELVAR_DATA_DIR).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ELVAR_DATA_DIR=
#
# First run: the server prints a one-time SETUP CODE to its log ("ELVAR SETUP CODE: ..."; on Vercel: Project > Logs).
# The wizard always asks for it (the local server also prints a link http://localhost:8787/?setup=... that fills it in).
# In env mode (ELVAR_ACCESS_TOKEN set) creating the owner account also needs that token. Advanced: fix the code yourself.
# ELVAR_SETUP_CODE=
#
# Env mode (no in-app account; settings are read-only in the app): one shared secret that gates /api/* from the browser header x-elvar-token.
# Leave empty to use the in-app owner account instead. Set a long random value if you use it.
ELVAR_ACCESS_TOKEN=
#
# Env mode profile: the owner profile as ONE line of JSON (name, how to address you, language, time zone, home city, features ...).
# Missing parts use neutral defaults. In the normal flow the wizard / settings screen edits the profile instead.
# ELVAR_PROFILE={"owner":{"name":"Taro","address":"Taro-sama"},"locale":{"timeZone":"Asia/Tokyo"},"home":{"city":"Tokyo","labelEn":"TOKYO"}}

# 難しい推論だけGroqに任せる（任意）。未設定ならこの機能は無効。キーはVercelの環境変数に直接入力する。
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING=medium

# 聞き取りと反応速度の調整（任意）。聞き取りが悪い→数値を上げる／反応が遅い→下げる
# GEMINI_LIVE_SILENCE_MS=600        # 話し終わりと判定する無音の長さ(ms)。既定600
# GEMINI_LIVE_PREFIX_MS=250         # 語頭の取りこぼし防止の余白(ms)。既定250
# GEMINI_LIVE_END_SENSITIVITY=low   # low=語尾まで聞く / high=早く区切る。既定low

# 第二の脳（GitHubのプライベートリポジトリにMarkdownで保存。Obsidianは無料のGitプラグインで同期できる。課金不要）
# BRAIN_GITHUB_TOKEN=   # Fine-grained token。対象はそのリポジトリだけ、権限は Contents: Read and write のみ。Vercelに直接入力
# BRAIN_REPO=owner/vault
# BRAIN_BRANCH=main
# BRAIN_DIR=            # リポジトリ内のサブフォルダ（任意）

# 使用状況レポートの目安（任意）。実際の上限は各サービスの管理画面で確認し、合わせて設定する
# GEMINI_LIVE_DAILY_MINUTES=60      # Gemini音声会話の1日あたりの目安（分）。既定60
# NEWSDATA_DAILY_CREDITS=200        # NewsData無料枠の1日のクレジット。既定200

# サブエージェント（裏で作業する担当）。GROQ_API_KEY があればGroq、なければGEMINI_API_KEYのGemini(OpenAI互換)を使う
# SUBAGENT_PROVIDER=groq            # groq / gemini を強制したいとき
# SUBAGENT_MODEL=                   # 既定: groq=openai/gpt-oss-120b, gemini=gemini-2.5-flash

# Web検索（調査担当・web_search）。EXA_API_KEY があれば Exa（推奨）、無ければ GEMINI_API_KEY のGoogle検索つき回答を使う
# EXA_API_KEY=                        # Vercelの環境変数に直接入力する（チャットに貼らない）
# WEB_SEARCH_PROVIDER=                # exa / gemini を強制したいとき
# WEB_SEARCH_MODEL=gemini-2.5-flash   # 検索に使うモデル
# WEB_SEARCH_DAILY=0                  # 使用状況レポートに出す1日の目安回数（0=上限なしで回数だけ表示）

# GroqとGeminiの使い分け（サブエージェント）。既定: 予定担当=Groq→Gemini、記憶/メール/資料/調査=Gemini→Groq（失敗したら右へ自動で切り替え）
# AGENT_LLM_MEMORY=gemini   # 担当ごとに優先を変える: AGENT_LLM_<MEMORY|MAIL|SCHEDULE|DOCUMENT|RESEARCH>=groq|gemini
# SUBAGENT_PROVIDER=        # 全担当をまとめて groq / gemini 優先にする
# DEEP_THINK_FALLBACK_MODEL=gemini-2.5-flash   # Groqが使えないとき、deep_think を代わりに答えるモデル

# サービスの使い分けと控え（server/routing.js）。既定は左から順に試し、失敗したら右へ。変えたいときだけ設定
# ROUTE_SEARCH_QUICK=gemini,exa          # 短い検索の順番
# ROUTE_SEARCH_DEEP=exa,gemini           # 調査の検索の順番（情報として表示。実際は調査担当が検索結果の道具を優先）
# ROUTE_WEATHER=open-meteo,met-no,search # 天気（MET Norwayは主要都市のみ。最後はウェブ検索で代用）
# ROUTE_NEWS=newsdata,exa,gemini         # ニュース
# GEMINI_LIVE_MODEL_FALLBACK=            # 控えのLiveモデル名。主モデルが使えない時、またはLiveの1日上限に達した時に切り替える（AI Studioのモデル名）
# METNO_USER_AGENT=elvar/1.0 (連絡先のメールなど)   # MET Norwayの利用規約が求める識別用

# 通知の同期（スマホの通知→暗号化→クラウド→PCのE.L.V.A.R.）。Upstash Redis（Vercel Marketplaceで作れる）。3日で自動削除。キーは Vercel に直接入力
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=      # （Vercel Marketplace の KV 連携なら KV_REST_API_URL / KV_REST_API_TOKEN でも可）

# 声が途中で切れるとき: 話し始めの判定の敏感さ。未設定=Geminiの標準 / low=自分の声の回り込みで止まりにくいが、あなたの小さな声を聞き逃しやすい / high=反応が速い
# GEMINI_LIVE_START_SENSITIVITY=
# 聞き取る言語（BCP-47、カンマ区切り）。既定は ja-JP,en-US（外国語への聞き間違いを防ぐ）。空にすると自動判定
# GEMINI_LIVE_INPUT_LANGS=ja-JP,en-US

# 通常の音声モード（Liveの上限に達したときの控え）。モデル名が変わったときだけ変える
# STD_CHAT_MODEL=gemini-2.5-flash
# STD_STT_MODEL=gemini-2.5-flash
# STD_TTS_MODEL=gemini-2.5-flash-preview-tts

# Sarashina（SB Intuitions・日本語に強いAI）。日本語の要約/分類/翻訳(jp_text)と、Geminiが使えないときの通常音声モードの返答の控えに使う
# SARASHINA_API_KEY=
# SARASHINA_ENABLED=1                                # 既定は「使わない」（キーを保存していても、1にするまで使われない。Gemini・Groqが代わりに処理する）
# SARASHINA_BASE_URL=https://api.sarashina.ai/v1   # 既定。公式ドキュメントと違うときだけ変更（キーの送り先なので、環境変数でのみ設定できます）
# SARASHINA_MODEL=sarashina3-mini                    # 標準の対話・生成
# SARASHINA_FAST_MODEL=sarashina3-nano               # 要約・分類など軽い作業（毎分60回まで。miniは毎分6回までなので、使えないときはnanoに自動で切り替わる）
# SARASHINA_AGENT_MODEL=sarashina3-nano              # サブエージェント用
# ROUTE_JP_TEXT=sarashina,gemini
# Sarashinaは、Groq/Geminiが上限・停止のときの控えにも使われる（サブエージェント、難しい推論、通常音声モードの返答）。
# 日本語の文章を書く担当（議事録・返信下書き）は、最初にSarashinaを使う。ツール呼び出しを受け付けない場合は、自動でその用途から外れる
# AGENT_LLM_<担当名>=sarashina|gemini|groq   # 担当ごとに最初のAIを指定（例: AGENT_LLM_MINUTES=gemini）

# 製作依頼（Claude Codeに作らせる）。企画書をGitHubのIssue（@claude付き）にして、Claude Code Actionに実装させる。docs/BUILD_REQUESTS.md
# BUILD_SELF_REPO=owner/your-elvar-fork # E.L.V.A.R.自身の機能追加・修正の依頼先（PRのみ。ここにも Claude Code Action と、同じトークンの権限が必要）
# BUILD_REPO=owner/name                 # Claude Code Action を入れた、製作用のリポジトリ
# BUILD_GITHUB_TOKEN=                    # そのリポジトリの Issues(Read/Write) / Pull requests(Read) / Contents(Read) / Actions(Read) の細かい権限のトークン
# CLAUDE_SESSION_RUN_LIMIT=20             # 任意。ご自分で決めた「5時間あたりのClaude Code実行回数の目安」。入れると製作の画面の5時間メーターがその目安に対する割合になります（公式の上限ではありません。未設定なら回数だけ表示）。Claudeの正確な残りは外部から読めません（claude.ai の 設定→使用状況、またはPCの /usage で確認）

# 文章を作るAI（Gemini / Groq / Sarashina）は、お互いの控えになる。どれか1つしか設定していなくても動く。
# キーが拒否された（401/403）・上限（429）・停止したAIは、しばらく（拒否30分／上限1分）自動で飛ばされ、残りのAIが代わりに処理する。
# 対象：日本語の要約・分類・翻訳(jp_text)、難しい推論(deep_think)、サブエージェント、通常音声モードの返答の控え。
# ※ 音声の聞き取り・読み上げ（通常音声モード）と、ウェブ検索の短い答えは、Gemini（検索はExaも）に頼ります。

# 基本の方針：すべての作業は、まずGeminiで行う。Groq・Sarashinaは、Geminiが使えないとき（上限・拒否・停止）の控え。
# 難しい推論(deep_think)を、Groqから先に使いたいときだけ: REASONING_PROVIDER=groq
# 特定のサブエージェントだけ別のAIにしたいとき: AGENT_LLM_<担当名>=groq
# --- Multi-user platform (docs/ELVAR_MULTIUSER.md; P1 adds the database layer, the sign-in switch comes in P2). All optional until then. -------------
# Postgres connection of the elvar_app role (Supabase: the Supavisor "transaction" pooler, port 6543). See supabase/README.md.
# ELVAR_DB_URL=postgres://elvar_app:<password>@<pooler-host>:6543/postgres
# Key that wraps every user's own encryption key: "<id>:<base64 of 32 random bytes>" (openssl rand -base64 32). Keep it out of the database and the repo.
# While rotating, put the new key here and the old one in ELVAR_KEK_PREV (comma separated for several).
# ELVAR_KEK=k1:
# ELVAR_KEK_PREV=
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# Service-role key: read only by server/db/service.js (Auth admin calls); never needed by the browser.
# SUPABASE_SECRET_KEY=
# Secret Vercel Cron sends as "Authorization: Bearer ...", at least 16 characters. Without it every cron route answers 503.
# CRON_SECRET=
