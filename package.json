{
  "name": "elvar",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "E.L.V.A.R. (Evolving Learning Virtual Adaptive Reasoning) - open-source personal voice assistant: HUD + Gemini Live voice",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "dev:web": "vite web --host",
    "build": "node scripts/pack-extension.mjs && vite build web",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --import ./test/_env.mjs --test \"test/*.test.mjs\"",
    "test:db": "node scripts/test-db.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@google/genai": "^2.32.0",
    "@mediapipe/tasks-vision": "^1.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "jose": "^6.2.16",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "postgres": "^4.1.0"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
