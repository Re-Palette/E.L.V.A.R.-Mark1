{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/api/google/execute",
      "destination": "/api/google-execute"
    },
    {
      "source": "/api/agent/run",
      "destination": "/api/agent-run"
    },
    {
      "source": "/api/system/check",
      "destination": "/api/system-check"
    },
    {
      "source": "/api/hud/data",
      "destination": "/api/hud-data"
    },
    {
      "source": "/api/google/callback",
      "destination": "/api/elvar?p=connect/google/callback"
    },
    {
      "source": "/api/google/status",
      "destination": "/api/elvar?p=connect/google/status"
    },
    {
      "source": "/api/elvar/:path*",
      "destination": "/api/elvar?p=:path*"
    }
  ],
  "functions": {
    "api/agent-run.js": {
      "maxDuration": 60
    },
    "api/system-check.js": {
      "maxDuration": 30
    },
    "api/hud-data.js": {
      "maxDuration": 20
    },
    "api/notif.js": {
      "maxDuration": 15
    },
    "api/chat.js": {
      "maxDuration": 40
    },
    "api/elvar.js": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "content-security-policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://generativelanguage.googleapis.com wss://generativelanguage.googleapis.com https://storage.googleapis.com https://*.supabase.co; worker-src 'self' blob:; frame-src 'self' blob: https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "x-frame-options",
          "value": "DENY"
        },
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        },
        {
          "key": "referrer-policy",
          "value": "no-referrer"
        },
        {
          "key": "permissions-policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "x-frame-options",
          "value": "DENY"
        },
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/elvar/cron/daily",
      "schedule": "17 4 * * *"
    }
  ]
}
